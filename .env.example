# Bazzaro application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL / Prisma
DATABASE_URL=postgresql://bazzaro:bazzaro@localhost:5432/bazzaro?schema=public

# Auth — keep server-side only
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Object storage (S3-compatible or Cloudinary)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=bazzaro-media
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# OAuth
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me

# Nepal payment gateways — server-side only
ESEWA_MERCHANT_ID=change-me
ESEWA_SECRET_KEY=change-me
KHALTI_SECRET_KEY=change-me
FONEPAY_MERCHANT_CODE=change-me
FONEPAY_SECRET_KEY=change-me

# Notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASSWORD=change-me
SMS_PROVIDER_URL=https://sms.example.com
SMS_PROVIDER_TOKEN=change-me

# Observability
SENTRY_DSN=
LOG_LEVEL=info
